{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "files": [
    "ai-analyst/errors.ts",
    "ai-analyst/contract.ts",
    "ai-analyst/grounding.ts",
    "ai-analyst/evidence.ts",
    "ai-analyst/provider.ts",
    "ai-analyst/handler.ts"
  ]
}
