# Copy to supabase/functions/.env.local for local Edge Function serving only.
# Never prefix provider secrets with VITE_ and never commit the local file.
OPENROUTER_API_KEY=replace-with-a-local-server-only-key
OPENROUTER_MODEL=provider/model-name
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AI_PROVIDER_TIMEOUT_MS=18000
AI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
